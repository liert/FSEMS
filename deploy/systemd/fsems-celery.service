[Unit]
Description=FSEMS Celery worker
After=network.target redis-server.service fsems-api.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fsems/backend
EnvironmentFile=/etc/fsems/fsems.env
ExecStart=/opt/fsems/backend/.venv/bin/celery -A app.core.celery_app:celery_app worker --loglevel=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
