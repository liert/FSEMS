# Dev: use repo-local paths (override in .env for production /var/fsems)
DATABASE_URL=sqlite+aiosqlite:///./data/fsems.db
FSEMS_WORKSPACE=./data/workspace
FSEMS_MNT_DIR=./data/mnt
FSEMS_KERNELS_DIR=./data/kernels
FSEMS_ROOTFS_DIR=./data/rootfs
# OPENWRT_DOWNLOAD_BASE=https://downloads.openwrt.org

# MCP Streamable HTTP（Agent 管理；随 API 挂载到 /mcp，也可 python -m app.mcp_server 独立端口）
MCP_ENABLED=true
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
MCP_STATELESS=true
MCP_JSON_RESPONSE=false
# MCP_TOKEN=change-me

REDIS_URL=redis://127.0.0.1:6379/0

API_HOST=127.0.0.1
API_PORT=8000

FSEMS_BRIDGE=br_fsems
FSEMS_BRIDGE_CIDR=192.168.1.10/24
FSEMS_BRIDGE_NET=192.168.1.0/24
FSEMS_PHY_NIC=eth0

QEMU_SERIAL_DIR=/tmp
BOOT_TIMEOUT_SEC=120
FSEMS_USER=

FSEMS_GUEST_SSH_USER=root
FSEMS_GUEST_SSH_PASSWORD=

FSEMS_ADMIN_USER=admin
FSEMS_ADMIN_PASSWORD=admin
SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_SECONDS=3600
